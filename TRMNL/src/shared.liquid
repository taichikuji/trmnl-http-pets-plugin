{%- capture svg_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <path fill="#000" d="M17.406,25.591c0,0 2.059,0.83 1.986,2.891c-0.072,2.062 -6.66,2.957 -6.66,11.094c0,8.137 9.096,14.532 19.217,14.532c10.12,0 23.872,-5.932 23.872,-17.83c0,-19.976 -1.513,-6.134 -17.276,-6.134c-5.235,0 -6.169,-1.787 -5.342,-2.806c3.91,-4.811 5.342,-17.446 -7.42,-17.446c-8.327,0.173 -10.338,6.946 -10.325,8.587c0.008,1.153 -1.204,1.543 -7.308,1.308c-1.536,5.619 9.256,5.804 9.256,5.804Zm3.77,-10.366c1.104,0 2,0.897 2,2c0,1.104 -0.896,2 -2,2c-1.103,0 -2,-0.896 -2,-2c0,-1.103 0.897,-2 2,-2Z"/>
</svg>
{%- endcapture -%}

<style>
  .view { background: #000; }
  .pet-image { filter: brightness({{ brightness | default: 1 }}) contrast({{ contrast | default: 1 }}); }
</style>

<div class="layout p--0">
  <img
    class="image image-dither image--contain pet-image"
    height="100%"
    width="100%"
    src="{{ image_url }}"
    alt="HTTP {{ code }}">
</div>

{% template title_bar %}
<div class="title_bar">
  <img class="image image--adaptive w--7 h--7" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="HTTP Pets logo">
  <span class="title">{{ title | default: 'HTTP Pets' }}</span>
  <span class="instance">
    <strong>{{ status }}</strong>: {{ instance }}
  </span>
</div>
{% endtemplate %}

{% render 'title_bar', svg_logo: svg_logo, title: plugin_name, status: code, instance: title %}

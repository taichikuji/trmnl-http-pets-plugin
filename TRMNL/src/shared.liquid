<style>
  .view { background: #000; }
  .pet-image { filter: brightness({{ brightness | default: 1 }}) contrast({{ contrast | default: 1 }}); }
</style>

<div class="layout p--0">
  <img
    class="image image-dither image--contain pet-image"
    height="100%"
    width="100%"
    src="{{ image_url }}"
    alt="HTTP {{ code }}">
</div>

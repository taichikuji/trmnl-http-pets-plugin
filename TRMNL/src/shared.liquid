<style>
  .view { background: #000; }
  .image { filter: brightness(1.15) contrast(1.1); }
</style>

<img
  class="image image-dither image--contain"
  height="100%"
  width="100%"
  src="{{ image_url }}"
  alt="HTTP {{ code }}">

{% template title_bar %}
<div class="title_bar">
  <img
    class="image image-dither image-stroke image-stroke--black"
    src="{{ favicon }}"
    width="28"
    height="28"
    alt="HTTP Pets logo" />
  <span class="title">{{ title | default: 'HTTP Pets' }}</span>
  <span class="instance">
    <strong>{{ status }}</strong>: {{ instance }}
  </span>
</div>
{% endtemplate %}
